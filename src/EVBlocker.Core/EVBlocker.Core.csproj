<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, analyzers: see Directory.Build.props at the repo root. -->

  <ItemGroup>
    <!-- Source generator for the Windows Firewall COM interop; see NativeMethods.txt.
         PrivateAssets=all because it runs at build time and ships nothing at runtime. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.335">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- EventLogQuery, used to read WFP audit events 5157/5156 from the Security log. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The auditpol CSV parser is an implementation detail but carries the trickiest logic in
         this assembly, so it is tested directly rather than promoted to the public surface. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>EVBlocker.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
