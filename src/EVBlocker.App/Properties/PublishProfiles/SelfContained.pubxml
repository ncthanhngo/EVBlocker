<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single file. Run with:
      dotnet publish src/EVBlocker.App -c Release -p:PublishProfile=SelfContained

  A profile rather than project properties: RuntimeIdentifier and SelfContained are not
  publish-only, and setting them on the project moves every ordinary build into a win-x64
  subdirectory, leaving a stale executable behind at the old path.

  No trimming. WPF does not support it - the SDK refuses with NETSDK1168 - so the ~63 MB this
  produces is the floor for a build that runs on a machine with no .NET installed.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>..\..\artifacts\self-contained\</PublishDir>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- No PDBs beside a released binary; the single file is the deliverable. DebugType only
         covers this project, so referenced assemblies need their symbols excluded separately. -->
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <!--
      InvariantGlobalization stays off, despite being the obvious way to save space. The interface
      is Vietnamese and the code formats dates and sorts names through CurrentCulture; turning it
      on collapses that to the invariant culture, so dates would render in US order and Vietnamese
      names would sort wrongly. A smaller download is not worth an interface that reads as broken.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
