<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, analyzers: see Directory.Build.props at the repo root. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon only; see Services/TrayIcon.cs. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFAC010 wants DPI awareness moved out of the manifest into the WinForms startup API. That
         is advice for a WinForms application; this is WPF, where the manifest is the right place. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>EVBlocker</AssemblyName>
    <RootNamespace>EVBlocker.App</RootNamespace>

    <!-- The icon Explorer and the taskbar show for the executable itself. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!--
      Packaging settings live in Properties/PublishProfiles/SelfContained.pubxml, not here.
      RuntimeIdentifier and SelfContained are not publish-only: setting them on the project moves
      every ordinary build into bin/Debug/net8.0-windows/win-x64/, leaving a stale executable at
      the old path that keeps being launched and keeps looking like the code did not change.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- WPF resolves types by reflection from XAML, so the trim analyser reports warnings it
         cannot prove either way. Trimming is configured for real in the packaging phase with
         TrimMode=partial; until then the analyser would only turn noise into build errors. -->
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded as a WPF resource, which is a separate thing from ApplicationIcon:
         Window.Icon resolves through the pack URI scheme and cannot read the exe's own icon. -->
    <Resource Include="Assets\app.ico" />

    <!-- Written beside the fixed copy under Program Files when blocking is turned on, so the way
         to undo the boot guard is on the machine before anyone needs it. See FixedInstall. -->
    <EmbeddedResource Include="..\..\tools\remove-boot-guard.ps1" LogicalName="remove-boot-guard.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is referenced for the tray icon alone. Its implicit global usings would make
         Application, MessageBox, Button and friends ambiguous in every WPF file, so they go. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EVBlocker.Core\EVBlocker.Core.csproj" />
  </ItemGroup>

</Project>
