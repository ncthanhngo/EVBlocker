<Window x:Class="EVBlocker.App.Views.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Quét ứng dụng đang chạy"
        Height="620" Width="900" MinHeight="420" MinWidth="700"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="8"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <!-- Same card treatment as the main window, so a dialog does not arrive with stock Windows
       chrome around it. -->
  <Border Margin="16" CornerRadius="14" RenderOptions.ClearTypeHint="Enabled">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="{DynamicResource ShellTopColor}" Offset="0" />
        <GradientStop Color="{DynamicResource ShellBottomColor}" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect Color="{DynamicResource CardShadowColor}"
                        BlurRadius="24" ShadowDepth="5" Direction="270"
                        Opacity="0.4" RenderingBias="Performance" />
    </Border.Effect>

    <DockPanel Margin="22,10,22,20">

      <Grid DockPanel.Dock="Top" Height="30">
        <TextBlock Text="Quét ứng dụng đang chạy" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Click="OnCancel" />
      </Grid>

      <TextBlock DockPanel.Dock="Top" Margin="0,8,0,14" TextWrapping="Wrap"
                 Style="{StaticResource MutedText}"
                 Text="Tích những ứng dụng được phép ra internet. Mọi thứ không tích sẽ bị chặn khi bạn bật chặn outbound — không cần tạo rule chặn riêng." />

      <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Content="Ẩn thành phần Windows" IsChecked="{Binding HideWindowsComponents}"
                    ToolTip="Các file trong thư mục Windows. Cho phép chúng theo đường dẫn hầu như luôn sai — baseline đã lo phần này theo tên service." />
          <CheckBox Content="Chỉ hiện app đang ra internet" Margin="20,0,0,0"
                    IsChecked="{Binding OnlyConnected}" />
        </StackPanel>

        <Grid Grid.Column="2">
          <TextBox x:Name="ScanSearch"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
          <TextBlock Text="Tìm theo tên hoặc đường dẫn…" IsHitTestVisible="False"
                     Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                     Foreground="{DynamicResource TextMutedBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=ScanSearch}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>

      <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Quét lại" Command="{Binding RescanCommand}" />
          <Button Content="Huỷ" Margin="10,0,0,0" Click="OnCancel" />
          <Button Content="Thêm vào allow-list" Margin="10,0,0,0"
                  Style="{StaticResource PrimaryButton}" Click="OnAccept" />
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource Card}" Padding="4,0,4,4">
        <DataGrid ItemsSource="{Binding Rows}" HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="44">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanSelect}"
                            HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="ỨNG DỤNG" Binding="{Binding Name}" Width="190" />
            <DataGridTextColumn Header="TIẾN TRÌNH" Binding="{Binding ProcessCountText}" Width="110" />
            <DataGridTextColumn Header="TÌNH TRẠNG" Binding="{Binding Status}" Width="130">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Đang ra internet">
                      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="ĐƯỜNG DẪN" Binding="{Binding ExecutablePath}" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding ExecutablePath}" />
                  <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </DockPanel>
  </Border>
</Window>
