<Window x:Class="EVBlocker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:EVBlocker.App.ViewModels"
        Title="EVBlocker" Height="760" Width="1180"
        MinHeight="620" MinWidth="980"
        Icon="/Assets/app.ico"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}">

  <!-- The resize grip lives in the transparent margin around the card, so it is wider than a
       window border would normally be: it is the only part of the window the pointer can find
       outside the card's own edge. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="10"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Shared by the rail's two lists so a row looks the same in both halves. -->
    <DataTemplate x:Key="RailItemTemplate">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Title}" Margin="11,0,0,0" VerticalAlignment="Center"
                   Foreground="{Binding Foreground,
                     RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                   FontWeight="{Binding FontWeight,
                     RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
      </StackPanel>
    </DataTemplate>

    <!-- ===================== section: live connections ===================== -->
    <DataTemplate DataType="{x:Type vm:ActiveConnectionsViewModel}">
      <DockPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox Content="Chỉ hiện kết nối ra internet" IsChecked="{Binding InternetOnly}" />
            <CheckBox Content="Ẩn kết nối đang đóng" Margin="22,0,0,0"
                      IsChecked="{Binding HideClosing}"
                      ToolTip="Bỏ qua những kết nối đã xong, máy chỉ đang dọn nốt" />
          </StackPanel>

          <!-- WPF has no placeholder, so a muted TextBlock sits behind the box and hides once
               anything is typed. IsHitTestVisible=False keeps clicks going to the TextBox. -->
          <Grid Grid.Column="2">
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
            <TextBlock Text="Tìm theo tên, phần mềm, địa chỉ hoặc mã tiến trình…" IsHitTestVisible="False"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Margin="4,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Actions.Message}"
                   Visibility="{Binding Actions.HasMessage, Converter={StaticResource BoolToVis}}" />

        <TextBlock DockPanel.Dock="Bottom" Margin="4,10,0,0"
                   Style="{StaticResource MutedText}" Text="{Binding Summary}" />

        <Border Style="{StaticResource Card}" Padding="4,0,4,4">
          <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Actions.Selected}"
                    ContextMenuOpening="OnRowMenuOpening">
            <!-- Right-click on a row: the decision the page exists to prompt. The DataGrid selects
                 the row under the pointer before the menu opens, so the commands act on it. -->
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Cho phép kết nối internet" Command="{Binding Actions.AllowCommand}" />
                <MenuItem Header="Hủy kết nối internet" Command="{Binding Actions.RevokeCommand}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="ỨNG DỤNG" Width="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Image Style="{StaticResource AppIconImage}"
                             Source="{Binding FullPath, Converter={StaticResource AppIcon}}" />
                      <TextBlock Text="{Binding AppName}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- The product the file belongs to; the publisher rides in the tooltip rather than a
                   column of its own, which pushed the port and protocol off the grid. -->
              <DataGridTextColumn Header="PHẦN MỀM" Binding="{Binding Software}" Width="170">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding SoftwareTooltip}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="MÃ TIẾN TRÌNH" Binding="{Binding ProcessId}" Width="118" />
              <DataGridTextColumn Header="KẾT NỐI TỚI" Binding="{Binding Destination}" Width="150" />
              <DataGridTextColumn Header="CỔNG" Binding="{Binding Port}" Width="60" />
              <DataGridTextColumn Header="LOẠI" Binding="{Binding Protocol}" Width="55" />
              <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding State}" Width="125" />
              <DataGridTextColumn Header="ĐƯỜNG DẪN" Binding="{Binding FullPath}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="ToolTip" Value="{Binding PathTooltip}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>
    </DataTemplate>

    <!-- ===================== section: attempt history ===================== -->
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
      <DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
          <TextBlock Text="Xem lại trong" VerticalAlignment="Center" Margin="0,0,10,0"
                     Style="{StaticResource SecondaryText}" />
          <!-- An explicit ItemTemplate rather than DisplayMemberPath: the latter does not reach
               SelectionBoxItemTemplate through a custom ComboBox template, and the closed box
               then falls back to the item's ToString(). -->
          <ComboBox Width="150" VerticalAlignment="Center"
                    ItemsSource="{x:Static vm:HistoryViewModel.LookbackOptions}"
                    SelectedItem="{Binding Lookback}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Tải lại" Margin="12,0,0,0"
                  Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <!-- Windows records nothing here until the audit subcategory is switched on, so without
             this panel the page is a blank grid that never fills, and the fix lived only in the
             documentation as a command to copy. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,14" Padding="16,12"
                CornerRadius="{StaticResource ControlRadius}"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    Content="Bật ghi nhật ký" VerticalAlignment="Center" Margin="14,0,0,0"
                    Command="{Binding EnableLoggingCommand}" />
            <TextBlock Text="{Binding SetupMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Margin="4,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Actions.Message}"
                   Visibility="{Binding Actions.HasMessage, Converter={StaticResource BoolToVis}}" />

        <TextBlock DockPanel.Dock="Bottom" Margin="4,10,0,0"
                   Style="{StaticResource MutedText}" Text="{Binding Status}" />

        <Border Style="{StaticResource Card}" Padding="4,0,4,4">
          <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Actions.Selected}"
                    ContextMenuOpening="OnRowMenuOpening">
            <!-- Right-click on a row: the decision the page exists to prompt. The DataGrid selects
                 the row under the pointer before the menu opens, so the commands act on it. -->
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Cho phép kết nối internet" Command="{Binding Actions.AllowCommand}" />
                <MenuItem Header="Hủy kết nối internet" Command="{Binding Actions.RevokeCommand}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="ỨNG DỤNG" Width="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Image Style="{StaticResource AppIconImage}"
                             Source="{Binding FullPath, Converter={StaticResource AppIcon}}" />
                      <TextBlock Text="{Binding AppName}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- The product the file belongs to; the publisher rides in the tooltip rather than a
                   column of its own, which pushed the port and protocol off the grid. -->
              <DataGridTextColumn Header="PHẦN MỀM" Binding="{Binding Software}" Width="170">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding SoftwareTooltip}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="BỊ CHẶN" Binding="{Binding BlockedCount}" Width="90" />
              <DataGridTextColumn Header="ĐƯỢC PHÉP" Binding="{Binding AllowedCount}" Width="110" />
              <DataGridTextColumn Header="LẦN CUỐI" Binding="{Binding LastSeen}" Width="140" />
              <DataGridTextColumn Header="ĐÃ KẾT NỐI TỚI" Binding="{Binding Destinations}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding FullPath}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>
    </DataTemplate>

    <!-- ===================== section: monitoring =====================
         One rail entry, two views. They answer the same question in two tenses, and the rail's
         weight belongs to the allow-list instead. -->
    <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
      <DockPanel>
        <Border DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,14" Padding="3"
                CornerRadius="{StaticResource ControlRadius}"
                Background="{DynamicResource SurfaceSunkenBrush}">
          <StackPanel Orientation="Horizontal">
            <ToggleButton Style="{StaticResource SegmentButton}" Content="Đang kết nối"
                          IsChecked="{Binding ShowLive}" />
            <ToggleButton Style="{StaticResource SegmentButton}" Content="Đã bị chặn"
                          IsChecked="{Binding ShowHistory}" />
          </StackPanel>
        </Border>

        <ContentControl Content="{Binding Active}"
                        Visibility="{Binding ShowLive, Converter={StaticResource BoolToVis}}" />
        <ContentControl Content="{Binding History}"
                        Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVis}}" />
      </DockPanel>
    </DataTemplate>

    <!-- ===================== section: allow-list ===================== -->
    <DataTemplate DataType="{x:Type vm:AllowListViewModel}">
      <DockPanel>

        <!-- One way in, not four.
             Adding used to be three buttons of equal weight beside a fourth route in the rail,
             all ending in the same result, with nothing to say which to reach for. The choices
             are now inside the one button, where they read as answers to "where from?". -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
          <Button x:Name="AddAppButton" Content="Thêm phần mềm…"
                  Style="{StaticResource PrimaryButton}" Click="OnOpenAddMenu">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Từ phần mềm đang chạy…" Command="{Binding ScanCommand}" />
                <MenuItem Header="Từ phần mềm đã cài…" Command="{Binding InstalledCommand}" />
                <MenuItem Header="Phần mềm quen thuộc đã cài" Command="{Binding AddCommonCommand}" />
                <MenuItem Header="Chọn file trên máy…" Command="{Binding AddCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Content="Bỏ cho phép" Margin="10,0,0,0" Command="{Binding RemoveCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="4,10,0,0" TextWrapping="Wrap"
                   Style="{StaticResource MutedText}" Text="{Binding Status}" />

        <Border Style="{StaticResource Card}" Padding="4,0,4,4">
          <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="ỨNG DỤNG" Width="192">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Image Style="{StaticResource AppIconImage}"
                             Source="{Binding ExecutablePath, Converter={StaticResource AppIcon}}" />
                      <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="THÊM LÚC" Binding="{Binding AddedAt}" Width="150" />
              <DataGridTextColumn Header="TÌNH TRẠNG" Binding="{Binding Status}" Width="160">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding FileMissing}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="ĐƯỜNG DẪN" Binding="{Binding ExecutablePath}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding ExecutablePath}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>
    </DataTemplate>

    <!-- ===================== section: usb =====================
         Scanning runs by itself when a drive appears; cleaning waits to be asked. Moving files
         off someone else's drive is not a thing to do quietly. -->
    <DataTemplate DataType="{x:Type vm:UsbViewModel}">
      <DockPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,14" TextWrapping="Wrap"
                   Style="{StaticResource MutedText}"
                   Text="Tự quét mỗi khi cắm ổ USB. Tìm loại virus ẩn thư mục rồi để lại shortcut trùng tên — bấm vào shortcut là máy nhiễm. File nghi ngờ được chuyển vào khu cách ly chứ không bị xoá, lấy lại được." />

        <Grid DockPanel.Dock="Bottom" Margin="4,10,0,0">
          <TextBlock Style="{StaticResource MutedText}" Text="{Binding Status}"
                     TextWrapping="Wrap" Margin="0,0,300,0" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Quét lại" Command="{Binding ScanCommand}" />
            <Button Content="Dọn ổ USB" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}"
                    ToolTip="Cách ly file nghi là virus và cho hiện lại thư mục bị ẩn" />
          </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="4,0,4,4">
          <DataGrid ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="MỨC" Binding="{Binding Level}" Width="150">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Level}" Value="Chắc chắn là virus">
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Level}" Value="Đáng ngờ">
                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <DataGridTextColumn Header="TÊN" Binding="{Binding Name}" Width="190" />
              <DataGridTextColumn Header="SẼ LÀM GÌ" Binding="{Binding Action}" Width="180" />

              <DataGridTextColumn Header="VÌ SAO" Binding="{Binding Reason}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding Path}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>
    </DataTemplate>

    <!-- ===================== section: ssh =====================
         A password gate over the machine list. The gate is a drawer lock, not security: the list
         is a readable file. One click opens a terminal into a machine as administrator. -->
    <DataTemplate DataType="{x:Type vm:SshViewModel}">
      <Grid>

        <!-- The gate. Shown until the password opens it. -->
        <Border Style="{StaticResource Card}" Padding="24,20" VerticalAlignment="Top"
                HorizontalAlignment="Left" Width="420"
                Visibility="{Binding Locked, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="MỞ MỤC SSH" Style="{StaticResource SectionLabel}" />
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                       Text="Nhập mật khẩu để xem và kết nối tới các máy. Đây chỉ là lớp che, không phải bảo mật thật." />
            <PasswordBox x:Name="SshPasswordBox" Margin="0,14,0,0"
                         PasswordChanged="OnSshPasswordChanged">
              <PasswordBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding UnlockCommand}" />
              </PasswordBox.InputBindings>
            </PasswordBox>
            <Button Content="Mở" Margin="0,14,0,0" HorizontalAlignment="Left"
                    Style="{StaticResource PrimaryButton}" Command="{Binding UnlockCommand}" />
            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource DangerBrush}"
                       Text="{Binding GateMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- The panel. Shown once unlocked. -->
        <DockPanel Visibility="{Binding Unlocked, Converter={StaticResource BoolToVis}}">

          <!-- The admin key and the one-time machine setup. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="KHOÁ CỦA MÁY NÀY" Style="{StaticResource SectionLabel}" />
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                         Text="{Binding KeyMessage}" />
              <TextBox Margin="0,10,0,0" Text="{Binding PublicKey, Mode=OneWay}" IsReadOnly="True"
                       TextWrapping="Wrap" FontSize="11.5" />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Chép khoá" Command="{Binding CopyKeyCommand}" />
                <Button Content="Chuẩn bị máy này để nhận SSH" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}" Command="{Binding PrepareCommand}"
                        ToolTip="Bật OpenSSH Server, mở cổng 22 cho mạng nội bộ và cài khoá bên dưới. Cần quyền quản trị." />
              </StackPanel>
              <TextBlock Margin="0,10,0,2" Style="{StaticResource MutedText}"
                         Text="Khoá được cấp phép trên máy này (dán khoá của máy quản trị nếu đang đứng ở máy đích):" />
              <TextBox Text="{Binding AdminPublicKeyInput, UpdateSourceTrigger=PropertyChanged}"
                       TextWrapping="Wrap" FontSize="11.5" />
            </StackPanel>
          </Border>

          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Thêm máy" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" />
            <Button Content="Xoá máy" Margin="10,0,0,0" Command="{Binding RemoveCommand}" />
            <Button Content="Tìm máy trong mạng" Margin="10,0,0,0" Command="{Binding RediscoverCommand}"
                    ToolTip="Hỏi toàn mạng nội bộ xem máy nào đang chạy EVBlocker và thêm vào danh sách" />
          </StackPanel>

          <TextBlock DockPanel.Dock="Bottom" Margin="4,10,0,0" TextWrapping="Wrap"
                     Style="{StaticResource MutedText}" Text="{Binding Status}" />

          <Border Style="{StaticResource Card}" Padding="4,0,4,4">
            <DataGrid ItemsSource="{Binding Hosts}" SelectedItem="{Binding Selected}"
                      CanUserAddRows="False">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="MỞ" Width="52" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Command="{Binding ConnectCommand}" Content="&#xE756;"
                              FontFamily="Segoe MDL2 Assets" FontSize="15" Padding="0" Width="34" Height="26"
                              ToolTip="Mở terminal SSH vào máy này" Cursor="Hand" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="TÊN MÁY" Binding="{Binding DisplayName}" Width="220" />
                <DataGridTextColumn Header="ĐỊA CHỈ IP" Binding="{Binding Address}" Width="180" />
                <DataGridTextColumn Header="TÀI KHOẢN ADMIN" Binding="{Binding Username}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </Grid>
    </DataTemplate>

    <!-- ===================== section: settings ===================== -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <StackPanel>

        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="CHẠY NỀN" Style="{StaticResource SectionLabel}" />
            <CheckBox Content="Tự chạy khi đăng nhập Windows, ẩn ở khay hệ thống" Margin="0,10,0,0"
                      IsChecked="{Binding StartWithWindows}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                       Text="Nút đóng cửa sổ chỉ ẩn EVBlocker xuống khay hệ thống, góc phải thanh tác vụ. Muốn tắt hẳn: bấm phải vào biểu tượng ở khay → Thoát EVBlocker. Việc chặn internet do tường lửa Windows thực hiện, không phụ thuộc ứng dụng có đang chạy hay không." />
          </StackPanel>
        </Border>

        <!-- Moved out of the enforcement strip, where it was a second row on every screen.
             It is a setting - whether the rules repair themselves at boot - not part of the
             decision to block, and it reaches the enforcement view model through the window
             because this template's own data context is the settings one. -->
        <Border Style="{StaticResource Card}" Padding="20,16"
                DataContext="{Binding DataContext.Enforcement,
                              RelativeSource={RelativeSource AncestorType=Window}}">
          <StackPanel>
            <TextBlock Text="KHI MỞ MÁY" Style="{StaticResource SectionLabel}" />
            <DockPanel Margin="0,10,0,0">
              <Button DockPanel.Dock="Right" Content="{Binding StartupToggleLabel}"
                      Command="{Binding ToggleStartupCommand}" VerticalAlignment="Center"
                      Margin="12,0,0,0" />
              <TextBlock Text="{Binding StartupTaskText}" VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                       Text="Việc chặn không cần mục này — Windows tự áp cấu hình tường lửa rất sớm khi mở máy. Mục này để phòng trường hợp danh sách bị phần mềm khác hoặc chính sách công ty xoá mất." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="GIAO DIỆN" Style="{StaticResource SectionLabel}" />
            <CheckBox Content="Dùng giao diện tối" Margin="0,10,0,0"
                      IsChecked="{Binding IsDarkTheme}" />
            <TextBlock Text="Mặc định là giao diện sáng. Lựa chọn được ghi nhớ cho lần mở sau."
                       Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="CẬP NHẬT" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="{Binding VersionText}" Margin="0,10,0,0" FontWeight="SemiBold" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Kiểm tra bản mới" Style="{StaticResource PrimaryButton}"
                      Command="{Binding CheckUpdateCommand}" />
              <Button Content="Mở trang phát hành" Margin="10,0,0,0"
                      Command="{Binding OpenReleaseCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding UpdateStatus}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Style="{StaticResource SecondaryText}" />

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                       Text="Chỉ kiểm tra khi bạn bấm nút. Ứng dụng này tồn tại để ngăn phần mềm tự ý ra internet, nên nó không tự liên hệ GitHub. Việc tải và cài bản mới do bạn thực hiện thủ công." />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- ===================== section: not built yet ===================== -->
    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
      <Border Style="{StaticResource Card}" Padding="48">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Control Style="{StaticResource LogoMark}" HorizontalAlignment="Center" Opacity="0.55" />
          <TextBlock Text="{Binding Heading}" Margin="0,18,0,0"
                     FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                     TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <!-- ==================== the two cards ====================

       The window itself is transparent. What the app looks like is two rounded cards stacked on
       whatever is behind it: the big one carries the interface, and the rail hangs off its left
       edge, over the top of it. The margins around the big card are not padding - they are where
       the shadow lands and where the resize grip lives.

       A transparent window normally costs ClearType, because WPF cannot subpixel-render onto a
       surface with an alpha channel. Both cards carry ClearTypeHint.Enabled and paint an opaque
       background of their own, which is the documented way back to sharp text. -->
  <Grid>

    <!-- ===== the big card ===== -->
    <Border x:Name="Shell" Margin="30,16,22,26" CornerRadius="18"
            RenderOptions.ClearTypeHint="Enabled">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
          <GradientStop Color="{DynamicResource ShellTopColor}" Offset="0" />
          <GradientStop Color="{DynamicResource ShellBottomColor}" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect Color="{DynamicResource CardShadowColor}"
                          BlurRadius="30" ShadowDepth="7" Direction="270"
                          Opacity="0.42" RenderingBias="Performance" />
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== title bar ==================== -->
        <Grid Grid.Row="0">
          <Control Style="{StaticResource LogoLockup}" HorizontalAlignment="Left"
                   Margin="18,0,0,0" VerticalAlignment="Center" />

          <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                  CornerRadius="6" Padding="10,3">
            <TextBlock Text="{Binding ElevationBadge}" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Margin="0,0,6,0"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource WindowButton}" Content="&#xE921;"
                    ToolTip="Thu nhỏ" Click="OnMinimise" />
            <Button Style="{StaticResource WindowButton}" Content="&#xE922;"
                    ToolTip="Phóng to" Click="OnMaximise" />
            <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;"
                    ToolTip="Đóng" Click="OnClose" />
          </StackPanel>
        </Grid>

        <!-- ==================== the stage ====================
             Inset past the rail, which hangs over this card rather than sitting beside it, so
             nothing a section draws ends up behind it. -->
        <DockPanel Grid.Row="1" Margin="222,4,26,22">

          <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}"
                     Text="{Binding SelectedSection.Title}" Margin="0,0,0,14" />

          <!-- Elevation notice.
               Deliberately not styled as a warning any more. Running without administrator
               rights is the intended default - the application opens this way on purpose so it
               never forces a UAC prompt just to look at a list - and an amber alert that is
               present on every screen of every launch teaches people to stop reading alerts. -->
          <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="12,6"
                  CornerRadius="{StaticResource ControlRadius}"
                  Background="{DynamicResource SurfaceSunkenBrush}"
                  Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVis}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Chạy lại với quyền quản trị"
                      VerticalAlignment="Center" Margin="14,0,0,0"
                      Command="{Binding RelaunchElevatedCommand}" />
              <TextBlock Text="{Binding ElevationMessage}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding ElevationMessage}"
                         Style="{StaticResource MutedText}" />
            </DockPanel>
          </Border>

          <!-- Enforcement strip.
               One line, because it sits above every section and the sections are what people
               came for: as a card it took 170px of a 760px window on all five pages, leaving
               seven visible rows in a list of a hundred connections. What moved out did not
               disappear - the startup self-check is a setting and now lives in Settings, and the
               per-profile detail only appears when the three profiles disagree. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,9" Margin="0,0,0,12"
                  DataContext="{Binding Enforcement}">
            <DockPanel>

              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                          Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ShowEnableControls, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="Tự bỏ chặn sau" VerticalAlignment="Center" Margin="0,0,8,0"
                             Style="{StaticResource MutedText}" />
                  <ComboBox Width="102" VerticalAlignment="Center"
                            ItemsSource="{x:Static vm:EnforcementViewModel.RevertOptions}"
                            SelectedItem="{Binding RevertAfter}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="Bắt đầu chặn" Margin="10,0,0,0"
                          Style="{StaticResource PrimaryButton}" Command="{Binding EnableCommand}" />
                </StackPanel>

                <Button Content="Giữ nguyên" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConfirmCommand}"
                        Visibility="{Binding ShowArmedControls, Converter={StaticResource BoolToVis}}" />

                <Button Content="Ngừng chặn" Margin="10,0,0,0" Command="{Binding DisableCommand}" />
              </StackPanel>

              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="On">
                          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Armed">
                          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <!-- The countdown, the per-profile detail and the last result share this line:
                     at most one of them has anything to say at any moment, and giving each its
                     own row would put the card straight back. -->
                <TextBlock Text="{Binding SecondLine}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SecondLine}"
                           Style="{StaticResource MutedText}"
                           Visibility="{Binding HasSecondLine, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </DockPanel>
          </Border>

          <ContentControl Content="{Binding SelectedSection.Content}" />
        </DockPanel>
      </Grid>
    </Border>

    <!-- ===== the rail =====
         A sibling of the big card rather than a child of it, which is the point: it hangs off
         the card's left edge and over its face, so the two read as pieces stacked on each other
         rather than one surface divided in two.

         The 40px top inset is the title bar's height - the rail cannot start above it without
         covering the wordmark. -->
    <Border x:Name="RailCard" Width="204" HorizontalAlignment="Left"
            Margin="6,56,0,66"
            CornerRadius="{StaticResource CardRadius}"
            RenderOptions.ClearTypeHint="Enabled"
            Background="{DynamicResource SidebarBrush}">
      <Border.Effect>
        <DropShadowEffect Color="{DynamicResource CardShadowColor}"
                          BlurRadius="26" ShadowDepth="6" Direction="300"
                          Opacity="0.5" RenderingBias="Performance" />
      </Border.Effect>

      <DockPanel Margin="0,14,0,12">

        <!-- No group heading any more. With two destinations there is nothing to group, and the
             one that was here said GIÁM SÁT above rows that were not monitoring. -->

        <TextBlock DockPanel.Dock="Bottom" Margin="18,0,14,0" TextWrapping="Wrap"
                   Text="{Binding Source={x:Static vm:MainViewModel.AppVersion}, Mode=OneTime}"
                   FontSize="11"
                   Foreground="{DynamicResource SidebarMutedBrush}" Opacity="0.75" />

        <!-- Settings sits at the foot of the rail in its own list. Two lists rather than one
             because a ListBox cannot pin its last row to the bottom; the view model ignores the
             null that the list not holding the selection writes back. -->
        <ListBox DockPanel.Dock="Bottom" Style="{StaticResource RailList}"
                 ItemsSource="{Binding BottomSections}"
                 SelectedItem="{Binding SelectedSection}"
                 Margin="0,0,0,14"
                 ItemTemplate="{DynamicResource RailItemTemplate}" />

        <ListBox Style="{StaticResource RailList}"
                 ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection}"
                 VerticalAlignment="Top"
                 ItemTemplate="{DynamicResource RailItemTemplate}" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
