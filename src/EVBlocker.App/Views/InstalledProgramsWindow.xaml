<Window x:Class="EVBlocker.App.Views.InstalledProgramsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Phần mềm đã cài"
        Height="640" Width="940" MinHeight="440" MinWidth="740"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="8"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <!-- Declared per window: the main window keeps its own copy, and a converter is cheaper to
       repeat than to reach for across a window boundary. -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <!-- Same card treatment as the scan dialog, which it sits beside in the same menu. -->
  <Border Margin="16" CornerRadius="14" RenderOptions.ClearTypeHint="Enabled">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="{DynamicResource ShellTopColor}" Offset="0" />
        <GradientStop Color="{DynamicResource ShellBottomColor}" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect Color="{DynamicResource CardShadowColor}"
                        BlurRadius="24" ShadowDepth="5" Direction="270"
                        Opacity="0.4" RenderingBias="Performance" />
    </Border.Effect>

    <DockPanel Margin="22,10,22,20">

      <Grid DockPanel.Dock="Top" Height="30">
        <TextBlock Text="Phần mềm đã cài" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Click="OnCancel" />
      </Grid>

      <TextBlock DockPanel.Dock="Top" Margin="0,8,0,14" TextWrapping="Wrap"
                 Style="{StaticResource MutedText}"
                 Text="Cùng danh sách Control Panel hiển thị, đọc từ cùng chỗ. Tích những phần mềm được phép ra internet. Phần mềm vừa cài xong có mặt ngay lần mở kế tiếp." />

      <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Content="Ẩn driver và thành phần nền" IsChecked="{Binding HideSupportComponents}"
                    ToolTip="Ẩn driver, bộ cài đi kèm và thành phần nền — chúng không tự ra internet" />
          <CheckBox Content="Chỉ hiện mục chưa quyết định" Margin="20,0,0,0"
                    IsChecked="{Binding UndecidedOnly}"
                    ToolTip="Phần mềm mới cài sẽ nằm ở đây" />
        </StackPanel>

        <Grid Grid.Column="2">
          <TextBox x:Name="ProgramSearch"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
          <TextBlock Text="Tìm theo tên hoặc đường dẫn…" IsHitTestVisible="False"
                     Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                     Foreground="{DynamicResource TextMutedBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=ProgramSearch}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>

      <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Đọc lại" Command="{Binding RefreshCommand}" />
          <Button Content="Huỷ" Margin="10,0,0,0" Click="OnCancel" />
          <Button Content="Cho phép ra internet" Margin="10,0,0,0"
                  Style="{StaticResource PrimaryButton}" Click="OnAccept" />
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource Card}" Padding="4,0,4,4">
        <DataGrid ItemsSource="{Binding Rows}" HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="44">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <!-- Hidden rather than merely disabled on rows with no executable: a greyed
                       empty box still reads as something to click, and roughly half the rows
                       cannot be resolved to a file. -->
                  <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center"
                            Visibility="{Binding CanSelect, Converter={StaticResource BoolToVis}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="PHẦN MỀM" Width="240">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" ToolTip="{Binding PathTooltip}">
                    <Image Style="{StaticResource AppIconImage}"
                           Source="{Binding FirstExecutable, Converter={StaticResource AppIcon}}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="NHÀ PHÁT HÀNH" Binding="{Binding Publisher}" Width="150">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="PHIÊN BẢN" Binding="{Binding Version}" Width="110" />
            <DataGridTextColumn Header="CÀI LÚC" Binding="{Binding InstalledOn}" Width="100" />

            <DataGridTextColumn Header="TÌNH TRẠNG" Binding="{Binding Status}" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Đã cho phép">
                      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsResolved}" Value="False">
                      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </DockPanel>
  </Border>
</Window>
