<Application x:Class="EVBlocker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    No StartupUri. The application decides in OnStartup whether to show a window at all: launched
    in reconcile mode it runs headless and exits with a status code, and a StartupUri would put a
    window on screen during boot, under the SYSTEM account, where nobody would ever see it.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <!--
        Merge order is load-bearing. Tokens and the palette are looked up by the two that
        follow, and a StaticResource is resolved at parse time, so a dictionary that uses a
        token must be merged after the one that defines it.
      -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Tokens.xaml" />
        <!-- Light is the default. OnStartup replaces this with whatever the user last chose;
             ThemeManager finds the palette by this file-name prefix, so the two must match. -->
        <ResourceDictionary Source="Themes/Palette.Light.xaml" />
        <ResourceDictionary Source="Themes/Logo.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
