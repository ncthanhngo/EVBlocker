<Application x:Class="EVBlocker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!--
        Merge order is load-bearing. Tokens and the palette are looked up by the two that
        follow, and a StaticResource is resolved at parse time, so a dictionary that uses a
        token must be merged after the one that defines it.
      -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Tokens.xaml" />
        <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
        <ResourceDictionary Source="Themes/Logo.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
